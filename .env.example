CRYPTO_SECRET=

# ---- IG spread betting (start with DEMO) ----
IG_API_KEY=
IG_IDENTIFIER=
IG_PASSWORD=
IG_DEMO=true
# Allow rounding a too-small bet up to IG's minimum (1.0 = never). Demo only.
IG_MAX_ROUND_UP=1.0

# ---- Telegram alerts (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Read-only portal (python -m portal) ----
PORTAL_USER=admin
PORTAL_PASSWORD=
